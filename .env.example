# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the publishable key belongs here. Never commit the secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin for invite, signup-confirmation, and password-reset links.
# Optional locally (the request host is used). Required on Vercel: without it the app refuses to
# generate links on a *.vercel.app host so members never hit Vercel's access gate.
# For phone testing, use your Mac's LAN address instead of localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
