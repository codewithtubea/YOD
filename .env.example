# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the publishable key belongs here. Never commit the secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Used for invite links and the legacy /auth/callback route. If unset, the request host is used.
# For phone testing, use your Mac's LAN address instead of localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
